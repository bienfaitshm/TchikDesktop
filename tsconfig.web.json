{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/renderer/**/*.tsx",
    "src/preload/*.d.ts",
    "src/packages/*",
    "src/packages/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "paths": {
      "@/renderer/*": ["./src/renderer/*"],
      "@/components/*": ["./src/renderer/components/*"],
      "@/packages/*": ["./src/packages/*"]
    }
  }
}
