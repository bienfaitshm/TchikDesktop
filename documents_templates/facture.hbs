<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture POS</title>
    <style>
        /* Configuration de la page pour une impression POS (Ticket / A6) */
        @page {
            size: A6 portrait; /* Ou "80mm auto" pour un rouleau thermique sans fin */
            margin: 5mm;
        }
        
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace; /* Style machine à écrire / ticket */
            font-size: 9pt;
            color: #000000;
            line-height: 1.3;
        }

        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .bold { font-weight: bold; }

        /* Lignes de séparation style ticket de caisse */
        .divider {
            border-top: 1px dashed #000000;
            margin: 6px 0;
        }

        .header h1 {
            font-size: 13pt;
            margin: 0 0 3px 0;
            text-transform: uppercase;
        }

        .header p {
            margin: 2px 0;
            font-size: 8pt;
        }

        .infos-facture {
            width: 100%;
            margin: 8px 0;
            font-size: 8.5pt;
        }

        /* Tableau des articles */
        .table-articles {
            width: 100%;
            border-collapse: collapse;
            font-size: 8.5pt;
            margin: 5px 0;
        }

        .table-articles th {
            border-bottom: 1px dashed #000000;
            padding: 4px 0;
            font-weight: bold;
        }

        .table-articles td {
            padding: 4px 0;
            vertical-align: top;
        }

        .table-totaux {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
        }

        .table-totaux td {
            padding: 2px 0;
        }

        .footer {
            margin-top: 15px;
            font-size: 8pt;
        }
    </style>
</head>
<body>

    <div class="header text-center">
        <h1>{{ entreprise.nom }}</h1>
        <p>{{ entreprise.adresse }}</p>
        <p>Tél: {{ entreprise.telephone }}</p>
    </div>

    <div class="divider"></div>

    <table class="infos-facture">
        <tr>
            <td class="bold">Facture N°:</td>
            <td>{{ numeroFacture }}</td>
        </tr>
        <tr>
            <td class="bold">Date:</td>
            <td>{{ date }}</td>
        </tr>
        <tr>
            <td class="bold">Caissier:</td>
            <td>{{ caissier }}</td>
        </tr>
    </table>

    <div class="divider"></div>

    <table class="table-articles">
        <thead>
            <tr>
                <th style="width: 55%;">Article</th>
                <th style="width: 15%; text-align: center;">Qté</th>
                <th style="width: 30%; text-align: right;">Total</th>
            </tr>
        </thead>
        <tbody>
            {{#each articles}}
            <tr>
                <td>
                    {{this.nom}}
                    {{#if this.remise}}
                        <br><span style="font-size: 7.5pt; font-style: italic;">(Remise -{{this.remise}}%)</span>
                    {{/if}}
                </td>
                <td class="text-center">{{this.quantite}}</td>
                <td class="text-right">{{this.prixTotal}} €</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="divider"></div>

    <table class="table-totaux">
        <tr>
            <td>Total Brut:</td>
            <td class="text-right">{{ totalBrut }} €</td>
        </tr>
        {{#if tva}}
        <tr>
            <td>TVA ({{ tva.taux }}%):</td>
            <td class="text-right">{{ tva.montant }} €</td>
        </tr>
        {{/if}}
        <tr class="bold" style="font-size: 10.5pt;">
            <td>NET À PAYER:</td>
            <td class="text-right">{{ netAPayer }} €</td>
        </tr>
    </table>

    <div class="divider"></div>

    <div class="footer text-center">
        <p class="bold">Merci de votre visite !</p>
        <p>Mode de règlement : {{ modePaiement }}</p>
        <p style="font-size: 7pt; margin-top: 10px; color: #555;">{{ logicielInfo }}</p>
    </div>

</body>
</html>