<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Reçu de Paiement - {{ schoolName }}</title>
    <style>
        /* Configuration de la page pour une impression POS (Ticket / A6) */
        @page {
    size: 80mm auto; /* Largeur exacte du rouleau (80mm ou 58mm) et hauteur automatique */
    margin: 0;       /* Supprime les marges par défaut du navigateur */
}
        
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
            font-size: 9pt;
            color: #000000;
            line-height: 1.3;
        }

        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .bold { font-weight: bold; }

        /* Lignes de séparation style ticket de caisse */
        .divider {
            border-top: 1px dashed #000000;
            margin: 6px 0;
        }

        .header h1 {
            font-size: 12pt;
            margin: 0 0 3px 0;
            text-transform: uppercase;
        }

        .header p {
            margin: 2px 0;
            font-size: 8pt;
        }

        .infos-facture {
            width: 100%;
            margin: 8px 0;
            font-size: 8.5pt;
            border-collapse: collapse;
        }

        .infos-facture td {
            padding: 2px 0;
            vertical-align: top;
        }

        /* Tableau des frais */
        .table-articles {
            width: 100%;
            border-collapse: collapse;
            font-size: 8.5pt;
            margin: 5px 0;
        }

        .table-articles th {
            border-bottom: 1px dashed #000000;
            padding: 4px 0;
            font-weight: bold;
        }

        .table-articles td {
            padding: 4px 0;
            vertical-align: top;
        }

        .table-totaux {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
            font-size: 8.5pt;
        }

        .table-totaux td {
            padding: 2.5px 0;
        }

        .footer {
            margin-top: 15px;
            font-size: 8pt;
        }
    </style>
</head>
<body>

    <!-- En-tête de l'école -->
    <div class="header text-center">
        <h1>{{ schoolName }}</h1>
        <p>{{ address }}</p>
    </div>

    <div class="divider"></div>

    <!-- Informations principales -->
    <table class="infos-facture">
        <tr>
            <td class="bold" style="width: 35%;">Réf. Ticket :</td>
            <td>{{ ticketRef }}</td>
        </tr>
        <tr>
            <td class="bold">Date :</td>
            <td>{{#if date}}{{ date }}{{else}}--/--/----{{/if}}</td>
        </tr>
        <tr>
            <td class="bold">Élève :</td>
            <td class="bold">{{ studentName }}</td>
        </tr>
        <tr>
            <td class="bold">Année scolaire :</td>
            <td>{{ yearName }}</td>
        </tr>
    </table>

    <div class="divider"></div>

    <!-- Détails des frais -->
    <table class="table-articles">
        <thead>
            <tr>
                <th style="width: 55%; text-align: left;">Désignation / Frais</th>
                <th style="width: 15%; text-align: center;">Statut</th>
                <th style="width: 30%; text-align: right;">Montant</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    {{ feeTypeName }}
                    <br><span style="font-size: 7.5pt; font-style: italic;">({{ scheduleName }})</span>
                </td>
                <td class="text-center" style="font-size: 7.5pt;">{{ status }}</td>
                <td class="text-right">{{ amountPaid }} {{ currency }}</td>
            </tr>
        </tbody>
    </table>

    <div class="divider"></div>

    <!-- Totaux et Paiement -->
    <table class="table-totaux">
        <tr>
            <td>Montant Versé :</td>
            <td class="text-right bold">{{ amountPaid }} {{ currency }}</td>
        </tr>
        <tr>
            <td>Total Dû (Global) :</td>
            <td class="text-right">{{ totalDue }} {{ currency }}</td>
        </tr>
        <tr>
            <td>Mode de Paiement :</td>
            <td class="text-right">{{ paymentMethod }}</td>
        </tr>
        {{#if transactionReference}}
        <tr>
            <td>Réf. Transaction :</td>
            <td class="text-right" style="font-size: 7.5pt;">{{ transactionReference }}</td>
        </tr>
        {{/if}}
        {{#if isPrinted}}
        <tr>
            <td colspan="2" class="text-center" style="font-size: 7pt; font-style: italic; padding-top: 4px;">
                (Duplicata - Déjà imprimé)
            </td>
        </tr>
        {{/if}}
    </table>

    <div class="divider"></div>

    <!-- Pied de page -->
    <div class="footer text-center">
        <p class="bold">Merci pour votre paiement !</p>
        <p style="font-size: 7pt; margin-top: 8px; color: #555;">Conservez ce reçu pour toute réclamation.</p>
    </div>

</body>
</html>