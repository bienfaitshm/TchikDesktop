{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/packages/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "types": ["electron-vite/node"],
    "paths": {
      "@/main/*": ["./src/main/*"],
      "@/packages/*": ["./src/packages/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
